<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#001a33">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Módulo 1: Conectividad REST"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00e5ff"
                android:layout_marginBottom="24dp" />

            <!-- Input: ID del Post -->
            <EditText
                android:id="@+id/et_post_id"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ingresa ID del Post"
                android:inputType="number"
                android:backgroundTint="#00bcd4"
                android:textColorHint="#80d8ff"
                android:textColor="#00e5ff"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Botón: Get Post -->
            <Button
                android:id="@+id/btn_get_post"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Obtener Post (GET)"
                android:textSize="14sp"
                android:backgroundTint="#00bcd4"
                android:layout_marginBottom="8dp" />

            <!-- Botón: Get All Posts -->
            <Button
                android:id="@+id/btn_get_all_posts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Obtener Todos los Posts"
                android:textSize="14sp"
                android:backgroundTint="#00bcd4"
                android:layout_marginBottom="24dp" />

            <!-- Inputs: Crear/Actualizar -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear/Actualizar Post"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00e5ff"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Título del Post"
                android:backgroundTint="#00bcd4"
                android:textColorHint="#80d8ff"
                android:textColor="#00e5ff"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_body"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:hint="Contenido del Post"
                android:backgroundTint="#00bcd4"
                android:textColorHint="#80d8ff"
                android:textColor="#00e5ff"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:gravity="top"
                android:layout_marginBottom="12dp" />

            <!-- Botón: Create Post -->
            <Button
                android:id="@+id/btn_create_post"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Crear Post (POST)"
                android:textSize="14sp"
                android:backgroundTint="#00bcd4"
                android:layout_marginBottom="8dp" />

            <!-- Botón: Update Post -->
            <Button
                android:id="@+id/btn_update_post"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Actualizar Post (PUT)"
                android:textSize="14sp"
                android:backgroundTint="#00bcd4"
                android:layout_marginBottom="8dp" />

            <!-- Botón: Delete Post -->
            <Button
                android:id="@+id/btn_delete_post"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Eliminar Post (DELETE)"
                android:textSize="14sp"
                android:backgroundTint="#ff6f00"
                android:layout_marginBottom="24dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ff5252"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Response Content -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Respuesta:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00e5ff"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_post_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#b3e5fc"
                android:background="#0d1f2d"
                android:padding="12dp"
                android:minHeight="120dp" />

        </LinearLayout>

    </ScrollView>

</layout>
