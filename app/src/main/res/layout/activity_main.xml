<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#001a33">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proyecto: Red y Seguridad"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00e5ff"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectividad asíncrona HTTP REST con JSONPlaceholder y persistencia segura de secretos utilizando APIs de almacenamiento nativas de Android."
            android:textSize="16sp"
            android:textColor="#b3e5fc"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btn_rest_api"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Módulo 1: Conectividad REST"
            android:textSize="16sp"
            android:backgroundTint="#00bcd4"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_security_storage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Módulo 3: Almacenamiento Seguro"
            android:textSize="16sp"
            android:backgroundTint="#00bcd4"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIS - Escuela Politécnica Nacional"
            android:textSize="12sp"
            android:textColor="#4dd0e1"
            android:gravity="center"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</layout>